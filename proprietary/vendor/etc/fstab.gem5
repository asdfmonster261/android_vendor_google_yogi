# Android fstab file.
#<src>                         <mnt_point>   <type>  <mnt_flags and options>  <fs_mgr_flags>
/dev/block/by-name/system      /system       erofs    ro                       wait,first_stage_mount,slotselect
/dev/block/by-name/system_ext  /system_ext   erofs    ro                       wait,first_stage_mount
/dev/block/by-name/system_dlkm /system_dlkm  erofs    ro                       wait,first_stage_mount
/dev/block/by-name/system_dlkm /system_dlkm  ext4    ro                       wait,first_stage_mount
/dev/block/by-name/vendor      /vendor       erofs    ro                       wait,first_stage_mount
/dev/block/by-name/vendor_dlkm /vendor_dlkm  erofs    ro                       wait,first_stage_mount
/dev/block/by-name/vendor_dlkm /vendor_dlkm  ext4    ro                       wait,first_stage_mount
/dev/block/by-name/product     /product      erofs    ro                       wait,first_stage_mount
/dev/block/by-name/userdata    /data         f2fs    noatime,sync             wait,first_stage_mount
