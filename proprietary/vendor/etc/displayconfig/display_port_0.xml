<!-- Yogi Configuration -->
<displayConfiguration>
    <name>Inner Display</name>
    <screenBrightnessMap>
        <point>
            <value>0.0</value>
            <nits>0.5</nits>
        </point>
        <point>
            <value>0.71</value>
            <nits>1450</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>2050</nits>
        </point>
    </screenBrightnessMap>

    <!-- 140 nits: (140-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
    <screenBrightnessDefault>0.068330459</screenBrightnessDefault>

    <highBrightnessMode enabled="true">
        <transitionPoint>0.71</transitionPoint>
        <minimumLux>10000</minimumLux>
        <timing>
            <!-- allow for 5 minutes out of every 20 minutes -->
            <timeWindowSecs>1200</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0</minimumHdrPercentOfScreen>
        <!--sdrHdrRatioMap, backed by spline, must have at least two entries -->
        <sdrHdrRatioMap>
            <point>
                <sdrNits>1.000</sdrNits>
                <hdrRatio>2.000</hdrRatio>
            </point>
            <point>
                <sdrNits>2.000</sdrNits>
                 <hdrRatio>4.000</hdrRatio>
            </point>
            <point>
                <sdrNits>5.000</sdrNits>
                <hdrRatio>4.000</hdrRatio>
            </point>
            <point>
                <sdrNits>100.000</sdrNits>
                <hdrRatio>8.000</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>

    <hdrBrightnessConfig>
        <brightnessMap>
            <point>
                <first>10.0</first>
                <!-- 1600 nits: (1600-1450)/(2050-1450)*(1.0-0.71)+0.71 = 0.7825 -->
                <second>0.7825</second>
            </point>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>10000</brightnessIncreaseDebounceMillis>
        <screenBrightnessRampIncrease>0.004</screenBrightnessRampIncrease>
        <brightnessDecreaseDebounceMillis>5000</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampDecrease>0.004</screenBrightnessRampDecrease>
    </hdrBrightnessConfig>

    <autoBrightness enabled="true">
    </autoBrightness>

    <colorSensor>
        <type>com.google.sensor.color</type>
        <name>TCS3743 Color</name>
    </colorSensor>

    <lightSensor>
        <type>com.google.sensor.auto_brightness</type>
        <name>Auto Brightness 0</name>
    </lightSensor>

    <proxSensor>
        <type></type>
        <name></name>
    </proxSensor>

    <tempSensor>
        <type>DISPLAY</type>
        <name>VIRTUAL-SKIN-INNER-DISPLAY</name>
    </tempSensor>

    <screenBrightnessRampIncreaseMaxMillis>2000</screenBrightnessRampIncreaseMaxMillis>
    <screenBrightnessRampDecreaseMaxMillis>20000</screenBrightnessRampDecreaseMaxMillis>

    <ambientBrightnessChangeThresholds>
        <brighteningThresholds>
            <minimum>10</minimum>
        </brighteningThresholds>
        <darkeningThresholds>
            <minimum>0</minimum>
        </darkeningThresholds>
    </ambientBrightnessChangeThresholds>

    <ambientLightHorizonLong>5000</ambientLightHorizonLong>
    <ambientLightHorizonShort>50</ambientLightHorizonShort>

    <powerThrottlingConfig>
        <!-- (200-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
        <brightnessLowestCapAllowed>0.097719903</brightnessLowestCapAllowed>
        <customAnimationRate>0.004</customAnimationRate>
        <pollingWindowMinMillis>20000</pollingWindowMinMillis>
        <pollingWindowMaxMillis>60000</pollingWindowMaxMillis>
        <powerThrottlingMap>
            <powerThrottlingPoint>
                <thermalStatus>light</thermalStatus>
                <powerQuotaMilliWatts>1010</powerQuotaMilliWatts>
                <!-- (526-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
                <brightnessFloor>0.25740255260</brightnessFloor>
            </powerThrottlingPoint>
            <powerThrottlingPoint>
                <thermalStatus>moderate</thermalStatus>
                <powerQuotaMilliWatts>743</powerQuotaMilliWatts>
                <!-- (358-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
                <brightnessFloor>0.17511210762</brightnessFloor>
            </powerThrottlingPoint>
            <powerThrottlingPoint>
                <thermalStatus>severe</thermalStatus>
                <powerQuotaMilliWatts>645</powerQuotaMilliWatts>
                <!-- (279-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
                <brightnessFloor>0.13641600552</brightnessFloor>
            </powerThrottlingPoint>
            <powerThrottlingPoint>
                <thermalStatus>critical</thermalStatus>
                <powerQuotaMilliWatts>419.7706118</powerQuotaMilliWatts>
            </powerThrottlingPoint>
        </powerThrottlingMap>
        <powerThrottlingMap id="concurrent">
            <powerThrottlingPoint>
                <thermalStatus>light</thermalStatus>
                <powerQuotaMilliWatts>743</powerQuotaMilliWatts>
                <!-- (358-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
                <brightnessFloor>0.17511210762</brightnessFloor>
            </powerThrottlingPoint>
            <powerThrottlingPoint>
                <thermalStatus>moderate</thermalStatus>
                <powerQuotaMilliWatts>645</powerQuotaMilliWatts>
                <!-- (279-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
                <brightnessFloor>0.13641600552</brightnessFloor>
            </powerThrottlingPoint>
            <powerThrottlingPoint>
                <thermalStatus>severe</thermalStatus>
                <powerQuotaMilliWatts>419.7706118</powerQuotaMilliWatts>
            </powerThrottlingPoint>
        </powerThrottlingMap>
    </powerThrottlingConfig>

    <thermalThrottling>
        <!-- default refreshRate throttling map -->
        <refreshRateThrottlingMap>
            <refreshRateThrottlingPoint>
                <!-- for thermal status critical -->
                <thermalStatus>critical</thermalStatus>
                <refreshRateRange>
                    <minimum>0</minimum>
                    <maximum>60</maximum>
                </refreshRateRange>
            </refreshRateThrottlingPoint>
            <refreshRateThrottlingPoint>
                <!-- for thermal status emergency and above -->
                <thermalStatus>emergency</thermalStatus>
                <refreshRateRange>
                    <minimum>0</minimum>
                    <maximum>30</maximum>
                </refreshRateRange>
            </refreshRateThrottlingPoint>
        </refreshRateThrottlingMap>
        <refreshRateThrottlingMap id="concurrent">
            <refreshRateThrottlingPoint>
                <!-- for thermal status critical and above -->
                <thermalStatus>critical</thermalStatus>
                <refreshRateRange>
                    <minimum>0</minimum>
                    <maximum>60</maximum>
                </refreshRateRange>
            </refreshRateThrottlingPoint>
        </refreshRateThrottlingMap>
    </thermalThrottling>

    <screenBrightnessRampFastDecrease>0.7047244</screenBrightnessRampFastDecrease>
    <screenBrightnessRampFastIncrease>0.7047244</screenBrightnessRampFastIncrease>
    <screenBrightnessRampSlowDecrease>0.024</screenBrightnessRampSlowDecrease>
    <screenBrightnessRampSlowIncrease>0.05</screenBrightnessRampSlowIncrease>

    <screenOffBrightnessSensor>
        <type>com.google.sensor.binned_brightness</type>
        <name>Binned Brightness 0 (wake-up)</name>
    </screenOffBrightnessSensor>
    <screenOffBrightnessSensorValueToLux>
        <item>-1</item> <!-- 0: OFF -->
        <item>0</item>  <!-- 1: NIGHT -->
        <item>5</item>  <!-- 2: LOW -->
        <item>80</item> <!-- 3: HIGH -->
        <item>1500</item> <!-- 4: SUN -->
    </screenOffBrightnessSensorValueToLux>

    <refreshRate>
        <refreshRateZoneProfiles>
            <refreshRateZoneProfile id="concurrent">
                <refreshRateRange>
                    <minimum>60</minimum>
                    <maximum>60</maximum>
                </refreshRateRange>
            </refreshRateZoneProfile>
        </refreshRateZoneProfiles>
    </refreshRate>

    <luxThrottling>
        <brightnessLimitMap>
            <type>adaptive</type>
            <map>
                <point>
                    <first>1000</first>
                    <!-- 600 nits (600-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
                    <second>0.293649534</second>
                </point>
                <point>
                    <first>6000</first>
                    <!-- 850 nits (850-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
                    <second>0.416105554</second>
                </point>
                <point>
                    <first>10000</first>
                    <!-- 1000 nits (1000-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
                    <second>0.489579165</second>
                </point>
            </map>
        </brightnessLimitMap>
    </luxThrottling>

    <supportsVrr>true</supportsVrr>

    <dozeBrightnessSensorValueToBrightness>
        <item>-1</item> <!-- 0: OFF -->
        <item>0.000244912</item> <!-- 1: NIGHT, 1 nits (1-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
        <item>0.004653329</item> <!-- 2: LOW, 10 nits (10-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
        <item>0.024246292</item> <!-- 3: HIGH, 50 nits (50-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
        <item>0.073228700</item> <!-- 4: SUN, 150 nits (150-0.5)/(1450-0.5)*(0.71-0.0)+0.0 -->
    </dozeBrightnessSensorValueToBrightness>

    <evenDimmer enabled="true">
      <transitionPoint>0.0</transitionPoint>

      <brightnessMapping>
          <brightnessPoint>
            <nits>0.5</nits>
            <backlight>0.0</backlight>
            <brightness>0.0</brightness>
          </brightnessPoint>
          <brightnessPoint>
            <nits>1450.0</nits>
            <backlight>0.71</backlight>
            <brightness>0.71</brightness>
          </brightnessPoint>
          <brightnessPoint>
            <nits>2050.0</nits>
            <backlight>1.0</backlight>
            <brightness>1.0</brightness>
          </brightnessPoint>
      </brightnessMapping>
      <luxToMinimumNitsMap>
          <point>
            <value>0</value><nits>0.24</nits>
          </point>
          <point>
            <value>10</value><nits>1.0</nits>
          </point>
          <point>
            <value>50</value><nits>2.0</nits>
          </point>
          <point>
            <value>1000</value><nits>2.0</nits>
          </point>
          <point>
            <value>3000</value><nits>2.6</nits>
          </point>
          <point>
            <value>6000</value><nits>4.8</nits>
          </point>
          <point>
            <value>10000</value><nits>7.8</nits>
          </point>
          <point>
            <value>20000</value><nits>15.0</nits>
          </point>
          <point>
            <value>50000</value><nits>36.7</nits>
          </point>
      </luxToMinimumNitsMap>
    </evenDimmer>
</displayConfiguration>
