#
# Yogi sensor device configuration registry script for the Proto 1.0 stage LED.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-mbu
#

?+0x72101

#
# Record reg_script.
#

+/
reg_script=yogi_proto_1_0_led.reg

#
# Sensors
#

# Color Lights Driver
+/dev/aw21024/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x30
  # Max current setting: I_max = 10.17mA * gcc_reg / 255.
  gcc_reg=75
  en_gpio_id=123
  # Set PWM frequency - 0:32KHz or 1:64KHz
  clkfrq_reg=0x1
  # Mapping from logical LED_ID to physical order on the ring.
  led_map=5 8 7 6 1 2 3 4
  # Tweak sRGB->PWM processing to force PWM values to zero when their sRGB counterpart is.
  null-means-null=1
  # Golden calibration values.
  xyz_to_pwm_0=16 0.319288 -0.088955 -0.03595 -0.064969 0.147402 -0.011241 0.00256 -0.005935 0.072027
  xyz_to_pwm_1=32 0.123498 -0.033091 -0.01437 -0.029939 0.067982 -0.00484 0.00131 -0.003028 0.034324
  # Auto-Brightness control
  abc_enable=1
  # Lux-to-Nits map.
  # Format: <num-of-pairs> <lux0> <nits0> <lux1> <nit1> ..
  abc_map_lux2nits=11 10 150 50 250 100 400 200 720 500 1500 1000 4200 1500 5760 2500 7440 5000 10560 10000 14000 50000 33600
  # Hysteresis window. Lux values have to go above (brightening) or below (darkening) the
  # thresholds for a brightness change to happen.
  # brightening_lux_thresh = MAX(last_lux + brighten_lux_val, lux * (1.0 + brighten_lux_pct))
  #   abc_hyst_brighten_lux_val, abc_hyst_brighten_lux_pct
  # darkening_lux_thresh = MIN(last_lux - darken_lux_val, last_lux * (1.0 - darken_lux_pct))
  #   abc_hyst_darken_lux_val, abc_hyst_darken_lux_pct
  # Debounce time before changing brightness.
  abc_debounce_brighten_ms=1000
  abc_debounce_darken_ms=1000
  # Brightness changing ramp configuration.
  #   abc_ramp_brighten_rate_nits_per_sec, abc_ramp_brighten_max_time_sec
  #   abc_ramp_darken_rate_nits_per_sec, abc_ramp_darken_max_time_sec

# ALSP
+/dev/tmd3743/0/als
  # DBV table and dependent parameters for each frequency in pwm_hz table.
  #   Each parameter is appended with an index, equal to the index of the
  #   PWM frequency it corresponds to, in the pwm_hz table.
  itime_table_brightness_0=1500 2918 16384
  itime_table_0=1600000 1200000 300000
  max_gain_table_0=7 7 7
  prox_delay_30hz_0=24700 24700 24700
  prox_delay_60hz_0=12000 12000 12000
  prox_delay_120hz_0=3600 3600 3600
  itime_table_brightness_1=1500 2918 16384
  itime_table_1=1600000 1200000 300000
  max_gain_table_1=7 7 7
  prox_delay_30hz_1=24700 24700 24700
  prox_delay_60hz_1=12000 12000 12000
  prox_delay_120hz_1=3600 3600 3600

+/dev/tmd3743/0/prox
  pulse_count=2
  pulse_len_us=32
  gain1=128

+/dev/tcs3743/0/als
  itime_table_0=1600000 1000000 300000
  itime_table_brightness_0=305 644 4096
  max_gain_table_0=7 7 7
  itime_table_1=1600000 1000000 300000
  itime_table_brightness_1=305 644 4096
  max_gain_table_1=7 7 7

# MAG 0 (MMC5616WA)
+/dev/mmc5616/0
  bus_name=i3c0
  bus_freq_hz=400000
  i3c_freq_hz=6250000
  bus_addr=0x30
  i3c_addr=0x14
  sensor_instance=1
  orientation_transform=-2 -1 -3
+/dev/mmc5616/0/mag
  name=MMC5616 Magnetometer 0

# MAG 1 (MMC5616WA)
+/dev/mmc5616/1
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x30
  sensor_instance=2
  orientation_transform=-2 1 3
+/dev/mmc5616/1/mag
  name=MMC5616 Magnetometer 1

# MAG 2 (MMC5616WA)
+/dev/mmc5616/2
  bus_name=i3c4
  bus_freq_hz=400000
  i3c_freq_hz=6250000
  bus_addr=0x30
  i3c_addr=0x14
  sensor_instance=3
  orientation_transform=2 1 -3
+/dev/mmc5616/2/mag
  name=MMC5616 Magnetometer 2

# BARO 1 (SPL07003).
+/dev/spxyz00n/1
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x76
+/dev/spxyz00n/1/baro
  name=SPL07003 Barometer
+/dev/spxyz00n/1/temp
  name=SPL07003 Temperature

+/dev/vd628x/0/rls
  lux_scale=108.1642
