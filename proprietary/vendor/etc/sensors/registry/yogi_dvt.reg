#
# Yogi sensor device configuration registry script for the DVT stage.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-mbu
#

?+0x70000:0xFFFF0000
# Exclude
?-0x72000:0xFFFFF000  # Proto
?-0x73000:0xFFFFF000  # EVT

#
# Record reg_script.
#

+/
reg_script=yogi_dvt.reg

#
# Sensors
#

# Color Lights Driver
+/dev/aw21024/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x34
  # Max current setting: I_max = 10.17mA * gcc_reg / 255.
  gcc_reg=75
  en_gpio_id=123
  # Set PWM frequency - 0:32KHz or 1:64KHz
  clkfrq_reg=0x1
  # Mapping from logical LED_ID to physical order on the ring.
  led_map=5 8 7 6 1 2 3 4
  # Tweak sRGB->PWM processing to force PWM values to zero when their sRGB counterpart is.
  null-means-null=1
  # Golden calibration values.
  xyz_to_pwm_0=17 0.305407 -0.076334 -0.038140 -0.056909 0.128453 -0.007079 0.001045 -0.002413 0.046540
  xyz_to_pwm_1=51 0.071175 -0.017698 -0.008921 -0.015351 0.034656 -0.001689 0.000441 -0.000991 0.014005

  # Auto-Brightness control
  abc_enable=1
  # Lux-to-Nits map.
  # Format: <num-of-pairs> <lux0> <nits0> <lux1> <nit1> ..
  abc_map_lux2nits=11 10 150 50 250 100 400 200 720 500 1500 1000 4200 1500 5760 2500 7440 5000 10560 10000 14000 50000 33600
  # Hysteresis window. Lux values have to go above (brightening) or below (darkening) the
  # thresholds for a brightness change to happen.
  # thresholds for a brightness change to happen.
  # brightening_lux_thresh = MAX(last_lux + brighten_lux_val, lux * (1.0 + brighten_lux_pct))
  #   abc_hyst_brighten_lux_val, abc_hyst_brighten_lux_pct
  # darkening_lux_thresh = MIN(last_lux - darken_lux_val, last_lux * (1.0 - darken_lux_pct))
  #   abc_hyst_darken_lux_val, abc_hyst_darken_lux_pct
  # Debounce time before changing brightness.
  abc_debounce_brighten_ms=1000
  abc_debounce_darken_ms=1000
  # Brightness changing ramp configuration.
  #   abc_ramp_brighten_rate_nits_per_sec, abc_ramp_brighten_max_time_sec
  #   abc_ramp_darken_rate_nits_per_sec, abc_ramp_darken_max_time_sec

# ALSP
+/dev/tmd3743/0/als
  # DBV table and dependent parameters for each frequency in pwm_hz table.
  #   Each parameter is appended with an index, equal to the index of the
  #   PWM frequency it corresponds to, in the pwm_hz table.
  itime_table_brightness_0=1500 2918 16384
  itime_table_0=1600000 1200000 300000
  max_gain_table_0=7 7 7
  prox_delay_1hz_0=20000 20000 20000
  prox_delay_10hz_0=20000 20000 20000
  prox_delay_30hz_0=20000 20000 20000
  prox_delay_60hz_0=20000 20000 20000
  prox_delay_120hz_0=20000 20000 20000
  itime_table_brightness_1=1500 2918 16384
  itime_table_1=1600000 800000 300000
  max_gain_table_1=7 7 7
  prox_delay_1hz_1=20000 20000 20000
  prox_delay_10hz_1=20000 20000 20000
  prox_delay_30hz_1=20000 20000 20000
  prox_delay_60hz_1=20000 20000 20000
  prox_delay_120hz_1=20000 20000 20000

+/dev/tmd3743/0/prox
  pulse_count=2
  pulse_len_us=64
  gain1=64

+/dev/tcs3743/0/als
  itime_table_0=1600000 300000
  itime_table_brightness_0=644 4096
  max_gain_table_0=7 7
  itime_table_1=1600000 900000 300000
  itime_table_brightness_1=305 644 4096
  max_gain_table_1=7 7 7

+/dev/vd628x/0/spectral
  # Golden values for calibration.
  golden_rals_r=711.5484375
  golden_rals_g=1130.980078
  golden_rals_b=556.4179688
  golden_rals_clr=5195.207813
  golden_rals_ir=1871.452344
  golden_rals_visible=2338.648047

+/dev/vd628x/0/rls
  lux_scale=109.373456

# MAG 0 (BMM350)
+/dev/bmm350/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x15
  orientation_transform=1 2 3
  sensor_instance=1
  tco_slopes_lid_det=-6.83e-04 -6.46e-04 -1.07e-03
  tco_offsets_lid_det=-0.56 -0.40 0.05
  tco_threshold_lid_det=150.0
  tco_slopes_lid_rel=-5.89e-04 -8.33e-04 -1.13e-03
  tco_offsets_lid_rel=0.22 -0.06 -0.05
  tco_threshold_lid_rel=150.0
+/dev/bmm350/0/mag
  name=BMM350 Magnetometer
  fac_cal_transform_lid_det=0.99769 -0.059827 -0.02671 -0.070109 0.95494 -0.039789 -0.055947 -0.12444 1.1305 0.0 0.0 0.0
  fac_cal_transform_lid_rel=0.98666 -0.085045 -0.028653 -0.069871 0.95419 -0.020995 -0.044062 -0.12667 1.1725 0.0 0.0 0.0
+/dev/bmm350/0/temp
  name=BMM350 Temperature

#MAGCC
+/dev/mag/1
  curr_comp_factors=0.05 1.76 1.86
  curr_comp_factors_fast=0.12 1.84 1.82
  curr_comp_factors_wireless=0.18 3.25 3.34
  curr_comp_factors_wireless_fast=0.18 3.25 3.34
  curr_comp_factors_folded=0.18 1.63 1.86
  curr_comp_factors_folded_fast=0.16 1.58 1.84
  curr_comp_factors_folded_wireless=0.55 2.77 3.20
  curr_comp_factors_folded_wireless_fast=0.55 2.77 3.20

# MAG 1 (MMC5616WA)
+/dev/mmc5616/0
  bus_name=i3c0
  bus_freq_hz=400000
  i3c_freq_hz=6250000
  bus_addr=0x30
  i3c_addr=0x14
  sensor_instance=2
  orientation_transform=-2 1 3
+/dev/mmc5616/0/mag
  name=MMC5616 Magnetometer
  fac_cal_transform=0.94296 0.010109 -0.0129 0.020253 1.0386 0.0060613 0.080626 0.0014341 1.0878 0.0 0.0 0.0
