  histo_dbv_eq_480_0_0=345 1000 0 0
  histo_dbv_eq_480_0_1=1001 2918 0 -2.453405284004056 0.009318658943592845 -1.3024804292031832e-05 8.875463727106102e-09 -2.9522760657760175e-12 3.818890401293909e-16
