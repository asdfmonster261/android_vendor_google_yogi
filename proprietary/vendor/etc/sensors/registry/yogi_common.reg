  intr_trigger_type=2
+/dev/camera_vsync/4 # RTCAM2AP_VSYNC
  intr_id=127
  intr_trigger_type=2

# RAINBOW (VD6283TG)
+/dev/vd628x/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x20
  pdm_id=4
  pcm_rate_hz=16000
  pdm_24b_samples=0

+/dev/vd628x/0/spectral
  auto_gain=1
  priority=0
  # Outgoing sample values follow the same order as HW.
  passthrough_channel_order=1
  # On-change thresholds for each color channel c: min_delta[c] ratio[c].
  # A value of -1 disables a threshold.
  # Change events are determined as follows:
  #  last_count[c]: the last sample count for each channel c
  #  count[c]: the current sample count for each channel c
  #   => delta[c] = abs(last_count[c] - count[c])
  #  thresh[c] = max(min_delta[c], last_count[c] * ratio[c])
  #  if delta[c] > thresh[c] for any channel c:
  #    Send a new sample with all current channel counts
  r_change_thresh=-1 -1
  g_change_thresh=100 0.1
  b_change_thresh=-1 -1
  c1_change_thresh=100 0.1
  c2_change_thresh=-1 -1
  ir_change_thresh=-1 -1

+/dev/vd628x/0/rls
  fix_fac_cal=1

+/dev/vd628x/0/flicker
  auto_gain=1
  # Flicker capture modes:
  #  0: Normal (on-chip flicker processing, PDM converting to PCM).
  #  1: Direct1 (on-chip direct passthrough, PDM bypass, driver PCM converting).
  #  2: Direct2 (on-chip direct passthrough, PDM converting to PCM)
  flicker_mode=2
  # The PDM clock in kHz
  pdm_clock_khz=3200
  # Upshift the sample to compensate for the -6dB stage in the PDM interface.
  sample_upshift=1

+/dev/auto_brightness/0
  dual_als=1

# TOUCH
+/dev/fst2/0
  bus_name=spi1
  bus_freq_hz=10000000
  spi_mode=0
  spi_word_size=8
  manual_cs_mode=1
  cs_clock_delay_us=1
  intr_id=142
  intr_type=2

# OUTER TOUCH
+/dev/s6e3ft0/1
  bus_name=spi3
  bus_freq_hz=1000000
  spi_mode=0
  spi_word_size=8
  manual_cs_mode=1
  cs_clock_delay_us=10
  spi_delay_between_write_read_us=40
  intr_id=141
  intr_type=2

+/touch/prox_gated_sensor
  single_tap_instance=1

# TBN
+/tbn
  tbn_mode=2
  device_count=2

# Binned Brightness 0
+/dev/binned_brightness/0
  # ALS sensor to use as input. This is matched to the ALS priority value.
  als_instance=1
  panel_id=0

# Binned Brightness 1
+/dev/binned_brightness/1
  # ALS sensor to use as input. This is matched to the ALS priority value.
  als_instance=2
  panel_id=1

# Double Twist
+/dev/double_twist/0
  prox_instance=1

# Virtual ALSP
+/dev/virtual_alsp/0
  hall_instance=0
  inner_panel_id=0

+/dev/virtual_alsp/0/als
  panel0_sensor_instance=1
  panel1_sensor_instance=2

+/dev/virtual_alsp/0/prox
  panel1_sensor_instance=1

+/dev/virtual_alsp/0/color
  panel0_sensor_instance=1
  panel1_sensor_instance=2

# Fusion Magnetometer Configuration
+/dev/fusion_mag/0/mag
  2nd_flip_avg=-16.30 3.60 -2.30 6.50 3.40 0.10
  weight_mixing_matrix=50.0
  weight_residual=5.0 1.0
  threshold=1.2
