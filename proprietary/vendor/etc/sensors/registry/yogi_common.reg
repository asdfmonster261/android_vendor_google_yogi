# SX932X Sar
+/dev/sx932x/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x28
  intr_id=137

  # SX932X registers' field. All of these set with decimal value
  # GnrlCtrl0(0x10), [4:0], SCANPERIOD   #(HEX)0x16 = (Binary)10110    => 100 ms.
  scan_period=22
  # ProxCtrl6(0x36), [7:0], PROXTHRESH01 #(HEX)0x1F = (Binary)00011111 => (31^2)/2 = 480.5
  prox_threshold01=31
  # ProxCtrl7(0x37), [7:0], PROXTHRESH23 #(HEX)0x1b = (Binary)00100111 => (27^2)/2 = 364.5
  prox_threshold23=27

  # AfeCtrl3(0x23),  [1:0], ARANGE01     #(HEX)0x01 = (Binary)1        => Large (+/-2.65pF).
  analog_range01=1
  # AfeCtrl4(0x24),  [2:0], RESOLUTION01 #(HEX)0x05 = (Binary)101      => 256.
  resolution01=5
  # ProxCtrl0(0x30), [2:0], RAWFILT01    #(HEX)0x05 = (Binary)101      => 1-1/32.
  raw_filt01=5

  # Hall sensor ID used for phone case detection of on sx932x.
  case_hall_sensor_id=1
  # AdvCtrl16(0x50), [3:2], STEADYWINDOW   #(HEX)0x00 = (Binary)0    => 4 samples.
  steady_window=0
  # AdvCtrl17(0x51), [7:4], STEADYMAXVAR01 #(HEX)0x08 = (Binary)1000 => 128.
  steady_max_var01=8
  # AdvCtrl17(0x51), [3:0], STEADYMAXVAR23 #(HEX)0x08 = (Binary)1000 => 128.
  steady_max_var23=8
+/dev/sx932x/0/ph1
  name=SX932X SAR Sensor 0
  priority=0
+/dev/sx932x/0/ph2
  name=SX932X SAR Sensor 1
  priority=1

