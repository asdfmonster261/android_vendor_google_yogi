  histo_dbv_eq_480_1_0=345 1000 0 0
  histo_dbv_eq_480_1_1=1001 2918 0 -2.4266084516999125 0.009161120359655984 -1.2698461153055393e-05 8.6173309413783e-09 -2.865037445653078e-12 3.7123886446808e-16
