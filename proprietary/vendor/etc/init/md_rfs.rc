on post-fs-data
    # FEATURE_MD_RFS_GOOGLE
    # Change user/permission
    mkdir /data/vendor/radio/md_rfs 0755 radio system
    restorecon_recursive /data/vendor/radio/md_rfs

on property:vendor.thinmd.removable_modem.reset_nvram=1
    # Reset NVRAM data when modem card change detected
    # This step is required in the factory flow
    start md_rfs_reset_nvram

service md_rfs /vendor/bin/md_rfs 0
    # FEATURE_MD_RFS_GOOGLE
    # Change to main class
    class main
    # FEATURE_MD_RFS_GOOGLE
    # Change to radio user
    user radio
    # FEATURE_MD_RFS_GOOGLE
    # Change group
    group system radio inet wakelock
    # FEATURE_MD_RFS_GOOGLE
    # Change capabilities
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    # FEATURE_MD_RFS_GOOGLE
    # Change ioprio
    ioprio rt 0
    # FEATURE_MD_RFS_GOOGLE
    # Avoid process be killed in shutdown stage
    shutdown critical

# FEATURE_MD_RFS_GOOGLE
service md_rfs_reset_nvram /vendor/bin/md_rfs_reset_nvram
    class main
    user radio
    group system
    disabled
    oneshot
