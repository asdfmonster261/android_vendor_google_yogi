# This should be everything required for init Epic

on init
    enable vendor.citadeld
    setprop vendor.nos.citadel.updates_tried 0
    setprop vendor.nos.citadel.do_boot_init 1

# This checks for and applies firmware updates
service vendor.init_citadel /vendor/bin/hw/init_citadel
    oneshot
    disabled
    user hsm
    group hsm
    ioprio idle 0

# This checks for and applies firmware updates during postinstall. Is disabled
# since we wait for postinstall service to explicitly invoke it.
service vendor.init_citadel_postinstall /vendor/bin/hw/init_citadel --firmware-root /postinstall
    oneshot
    disabled
    user hsm
    group hsm
    ioprio idle 0

# Only do init_citadel once. Use the updates_tried property to control this.
on property:init.svc.vendor.citadeld=running && property:vendor.nos.citadel.do_boot_init=1
    setprop vendor.nos.citadel.do_boot_init 0
    start vendor.init_citadel
